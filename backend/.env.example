# Copier ce fichier en .env et renseigner les valeurs.
# Ne JAMAIS commiter le fichier .env.

# development | production | test
NODE_ENV=development

# Nom de l'environnement (étiquette des logs et métriques) : staging | production
# APP_ENV=development
PORT=5000

# Local : mongodb://localhost:27017/exam_practice_db
# Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<base>
MONGO_URI=mongodb://localhost:27017/exam_practice_db

# Secret de signature des JWT (64 octets aléatoires minimum recommandés). Générer avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Durée de vie de la session, en secondes (défaut : 3600)
JWT_EXPIRES_IN=3600

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# Cookie "secure" (HTTPS uniquement). Défaut : true si NODE_ENV=production
# COOKIE_SECURE=false

# Nombre de proxys de confiance devant l'API (1 sur Render)
# TRUST_PROXY=1

# Jeton protégeant /metrics (vide = route désactivée)
# METRICS_TOKEN=

# Niveau de log : error | warn | info | debug (défaut : info en prod, debug sinon)
# LOG_LEVEL=info

# Écrire aussi les logs dans logs/*.log (utile en local)
# LOG_TO_FILE=true

# Logs de développement du module debug : DEBUG=app:*

# Politique SameSite du cookie : lax (défaut) | strict | none.
# "none" (avec HTTPS) uniquement si front et API sont sur des sites différents,
# par ex. deux adresses *.onrender.com avant la mise en place des sous-domaines.
# COOKIE_SAMESITE=lax
